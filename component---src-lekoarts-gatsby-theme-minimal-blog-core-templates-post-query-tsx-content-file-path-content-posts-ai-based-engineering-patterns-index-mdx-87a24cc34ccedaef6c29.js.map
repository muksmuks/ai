    className: "language-text"
  }, "+-----------------------------------------------------------------------+\n|                         THE VENDOR PIT TRAP                           |\n|                                                                       |\n|  Model vendors (e.g., OpenAI, Anthropic) operate with internal        |\n|  models and unlimited token spend, demonstrating agents managing      |\n|  massive, unstructured codebases.                                     |\n|                                                                       |\n|  ENTERPRISE REALITY: Enterprises operate on finite token budgets.     |\n|  Unstructured codebases bloat context windows, exponentially          |\n|  inflating API costs and reducing model reasoning performance.        |\n+-----------------------------------------------------------------------+\n")), "\n", React.createElement(_components.p, null, "As detailed by industry practitioners, model vendors operate with internal model access and effectively unlimited compute budgets, demonstrating agents autonomously maintaining massive, unstructured repositories. This sets a \"pit trap\" for enterprises. When organizations adopt unguided AI generation without architectural governance, their codebases suffer from severe context bloat, resulting in three major operational penalties:"), "\n", React.createElement(_components.ol, null, "\n", React.createElement(_components.li, null, React.createElement(_components.strong, null, "Escalating Inference Spend"), ": Processing bloated context windows across hundreds of daily agent passes inflates enterprise API token bills."), "\n", React.createElement(_components.li, null, React.createElement(_components.strong, null, "Degraded Model Reasoning"), ": LLMs operating over messy context windows experience reduced reasoning accuracy, lose focus on subtle instructions, and make frequent off-target code edits."), "\n", React.createElement(_components.li, null, React.createElement(_components.strong, null, "Compounding Refactoring Costs"), ": To fix bugs in a messy codebase, agents apply localized patches rather than clean refactors, accelerating architectural decay."), "\n"), "\n", React.createElement(_components.h4, null, "Actionable Recommendations for Engineering Leadership:"), "\n", React.createElement(_components.ol, null, "\n", React.createElement(_components.li, null, React.createElement(_components.strong, null, "Mandate Human Ownership of Top-Level Architecture"), ": Require senior engineers to design and approve component topologies, module contracts, and domain schemas before initiating AI generation."), "\n", React.createElement(_components.li, null, React.createElement(_components.strong, null, "Standardize Scratch Schema Workflows"), ": Integrate lightweight scratch Python specification files using ", React.createElement(_components.code, null, "pass"), " and ", React.createElement(_components.code, null, "Ellipsis"), " (", React.createElement(_components.code, null, "..."), ") into standard pull request planning phases to establish clear implementation boundaries."), "\n", React.createElement(_components.li, null, React.createElement(_components.strong, null, "Deploy Automated Slop Detection in CI/CD Pipelines"), ": Implement static analysis and slop detection tools to catch code duplication, unnecessary abstraction layers, and context bloat before code is merged."), "\n", React.createElement(_components.li, null, React.createElement(_components.strong, null, "Shift Code Review Metrics to Behavioral Validation"), ": Reallocate code review criteria away from manual syntax inspection toward automated test suite execution, invariant verification, and interactive runtime testing."), "\n", React.createElement(_components.li, null, React.createElement(_components.strong, null, "Enforce Proportional Risk-Driven Architectural Governance"), ": Scale architectural effort proportionally to operational risk—permitting rapid agent autonomy for low-risk, disposable utilities